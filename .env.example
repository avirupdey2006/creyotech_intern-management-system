# =============================================================================
# APPLICATION & ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
APP_NAME="Intern Management System"
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://ims.vercel.app"]

# =============================================================================
# NEON POSTGRESQL DATABASE
# Use the pooled Neon connection URL for application traffic.
# Use the direct URL for database migrations where appropriate.
# =============================================================================
DATABASE_URL=postgresql+asyncpg://db_user:db_password@ep-cluster-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://db_user:db_password@ep-cluster.region.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# JWT AUTHENTICATION
# Generate unique secrets for each environment.
# =============================================================================
JWT_SECRET_KEY=your_unique_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local development only; set COOKIE_SECURE=true in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# =============================================================================
# PII ENCRYPTION & SIGNING
# =============================================================================
PII_ENCRYPTION_KEY=your_base64_encoded_pii_encryption_key_here=
HMAC_SIGNING_SECRET=your_hmac_signing_secret_here
SIGNED_URL_EXPIRY_SECONDS=300

# =============================================================================
# THIRD-PARTY KYC
# =============================================================================
KYC_PROVIDER=MOCK
KYC_API_BASE_URL=https://sandbox.cashfree.com/verification
KYC_CLIENT_ID=your_kyc_client_id_here
KYC_CLIENT_SECRET=your_kyc_client_secret_here

# =============================================================================
# KAFKA EVENT STREAMING
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DOCUMENT_GENERATION=intern.document.generate
KAFKA_TOPIC_EMAIL_NOTIFICATION=intern.notification.email
KAFKA_CONSUMER_GROUP=ims-backend-workers

# =============================================================================
# EMAIL DISPATCHER
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
EMAIL_DAILY_LIMIT=100

# =============================================================================
# DOCUMENT STORAGE
# =============================================================================
ENCRYPTED_STORAGE_DIR=D:/intern-management-system/backend/storage/encrypted_docs

# =============================================================================
# FRONTEND (Next.js)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# =============================================================================
# OBSERVABILITY: PINO LOGS & SENTRY ALERTS
# =============================================================================
LOG_LEVEL=INFO
SENTRY_DSN=your_backend_sentry_dsn_here
SENTRY_TRACES_SAMPLE_RATE=1.0
NEXT_PUBLIC_SENTRY_DSN=your_frontend_sentry_dsn_here
